<h2>Login</h2>
[% IF err %]<p class=error><strong>Error:</strong> [% err %][% END %]
<form action="[% login_url %]" method=post>
<table><tr><td>
  <dl>
    <dt>Username:
    <dd><input type=text name=username>
    <dd><input type=submit value=Login>
  </dl>
</td><td>
<img src=images/djedefre.jpg>
</td>
</tr></table>
</form>
